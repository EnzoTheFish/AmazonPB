# Copie para .env e ajuste se necessário
MONGO_URI=mongodb://localhost:27017
MONGO_DB=amazon_pb

# Cache: "redis" (padrão; se o Redis estiver fora, a app segue direto no MongoDB) ou "none"
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Carrinho ativo no Redis: segundos até um carrinho sem alterações expirar
CARRINHO_TTL=7200
