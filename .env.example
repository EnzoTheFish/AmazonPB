# Copie para .env e ajuste se necessário
MONGO_URI=mongodb://localhost:27017
MONGO_DB=amazon_pb

# Cache: "redis" (padrão; se o Redis estiver fora, a app segue direto no MongoDB) ou "none"
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Carrinho ativo no Redis: segundos até um carrinho sem alterações expirar
CARRINHO_TTL=7200

# Neo4j (grafo de recomendações)
# Opção 1 - Docker local (docker compose up -d neo4j): valores abaixo já funcionam.
# Opção 2 - AuraDB (nuvem): troque pelos dados do AuraDB, ex.: NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=pbstore123
NEO4J_DATABASE=neo4j
